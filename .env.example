DATABASE_URL=postgresql+psycopg://vernier:vernier@localhost:5433/vernier
REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible LLM. Featherless is used when FEATHERLESS_API_KEY is set.
FEATHERLESS_API_KEY=
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Optional alternatives
# XAI_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.6
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

CACHE_TTL_SECONDS=604800
PROMPT_VERSION=review-v1
BATCH_MAX_CHARS=8000
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true

NEXT_PUBLIC_API_URL=http://localhost:8000
